#!/bin/bash

set -euo pipefail

show_help() {
  cat << EOF
Usage: ./bin/php [PHP_ARGS...]

Run PHP commands inside the dev event-listener container.

Examples:
  ./bin/php -v                      Show PHP version
  ./bin/php script.php              Run a PHP script
  ./bin/php -r "echo phpinfo();"    Execute PHP code
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  show_help
  exit 0
fi

PARENT_PATH=$(
  cd "$(dirname "${BASH_SOURCE[0]}")"
  pwd -P
)

cmd=$(printf '%q ' php "$@")

"${PARENT_PATH}/env" dev exec -T event-listener runuser --preserve-environment hostuser -c "${cmd}"
