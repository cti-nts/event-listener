{
  "name": "evdobe/event-listener",
  "description": "A process that listens to a domain event channel, translates and persists events of interest to an event store.",
  "authors": [
    {
      "name": "Konstantinos Togias",
      "email": "info@ktogias.gr"
    }
  ],
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Application\\": "Application",
      "Infrastructure\\": "Infrastructure"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Application\\": "tests/unit/Application",
      "Infrastructure\\": "tests/unit/Infrastructure"
    }
  },
  "scripts": {
    "lint": [
      "@fix"
    ],
    "fix": [
      "@rector",
      "@cs-fixer"
    ],
    "format": "@cs-fixer",
    "cs-fixer": "php-cs-fixer fix",
    "phpstan": "phpstan --configuration=./phpstan.neon --memory-limit=-1",
    "stan": "@phpstan",
    "rector": "rector process --no-diffs --config=./rector.php",
    "behat": "behat",
    "phpunit": "phpunit --colors=always tests/unit",
    "test": "@phpunit"
  },
  "require": {
    "php": "^8.4",
    "enqueue/enqueue": "^0.10.27",
    "enqueue/rdkafka": "^0.10.27",
    "php-di/php-di": "^7.1"
  },
  "require-dev": {
    "beberlei/assert": "^3.3.3",
    "behat/behat": "^3.29",
    "curl/curl": "^2.5",
    "friendsofphp/php-cs-fixer": "^3.94",
    "kwn/php-rdkafka-stubs": "^3.0",
    "phpspec/prophecy": "^1.25",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-beberlei-assert": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^12.5",
    "rector/rector": "^2.3",
    "swoole/ide-helper": "^6.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
